@using Heracles.Blazor.Theme
@inherits ErrorBoundary
@inject IThemeManager ThemeManager
@if (CurrentException is not null)
{
	<style>
		.error-scroll {
			/* Firefox */
			scrollbar-width: thin;
			scrollbar-color: rgba(107, 114, 128, 0.8) transparent; /* thumb, track */

			/* WebKit (Chrome, Edge, Safari) */
		}

		.error-scroll::-webkit-scrollbar {
			width: 6px;
		}

		.error-scroll::-webkit-scrollbar-track {
			background: transparent;
		}

		.error-scroll::-webkit-scrollbar-thumb {
			background-color: rgba(107, 114, 128, 0.8); /* similar to Tailwind gray-500 */
			border-radius: 9999px;
			border: 2px solid transparent;
		}
	</style>

	<div
		class="w-full h-screen flex align-center justify-center"
	>
		<div Class="p-4 border max-w-150 rounded-md "

		>
			<h3>🔥 UNHANDLED ERROR</h3>
			<div class="text-base my-2 overflow-auto error-scroll">
				@CurrentException.Message
			</div>

			@if (CurrentException.StackTrace is not null)
			{
				<div class="text-xs rounded-md border my-4 p-2 max-h-64 overflow-auto error-scroll"
				>
					@CurrentException.StackTrace
				</div>
			}

			<div class="w-full flex">
				<button class="rounded-full px-4 py-2 mt-4 ml-auto cursor-pointer"

				        @onclick="HandleRecoveryAction">Recover
				</button>
			</div>

			<div class="text-xs mt-2">
				Note: If the first Recover attempt doesn’t work, simply try clicking it again.
			</div>

		</div>
	</div>
}
else
{
	@ChildContent
}

@code
{
	[Parameter] public Action? HandleRecovery { get; set; }

	private bool _isDarkMode;


	protected override void OnAfterRender(bool firstRender)
	{
		_isDarkMode = ThemeManager.IsDarkMode;
	}

	private void HandleRecoveryAction()
	{
		// Reset the error boundary so the app renders again
		Recover();

		// Invoke the recovery action if provided
		HandleRecovery?.Invoke();
	}

}
