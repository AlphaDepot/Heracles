@inject CarouselService CarouselService

<div class="relative @Class"
     @onkeydown="HandleKeyDown"
     role="region"
     aria-roledescription="carousel">

	<CascadingValue Name="CarouselId" Value="_id">
		<CascadingValue Name="Orientation" Value="Orientation">
			@ChildContent
		</CascadingValue>
	</CascadingValue>

</div>

@code {
	[Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;
	[Parameter] public object? Options { get; set; }
	[Parameter] public List<object> Plugins { get; set; } = [];
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string? Class { get; set; }
	[Parameter] public bool Loop { get; set; }
	[Parameter] public bool Autoplay { get; set; }
	[Parameter] public int AutoplayDelay { get; set; } = 4000;


	private readonly string _id = Guid.NewGuid().ToString("N");

	protected override void OnInitialized()
	{
		if (Autoplay)
		{
			Plugins.Add(new
			{
				name = "autoplay",
				options = new { delay = AutoplayDelay }
			});
		}

		CarouselService.Register(
			_id,
			Orientation,
			Options ?? new
			{
				axis = Orientation == Orientation.Horizontal ? "x" : "y",
				loop = Loop
			},
			Plugins.ToArray()
		);
	}


	private async Task HandleKeyDown(KeyboardEventArgs e)
	{
		if (e.Key == "ArrowLeft")
			await CarouselService.GoPrevAsync(_id);
		else if (e.Key == "ArrowRight")
			await CarouselService.GoNextAsync(_id);
	}

}