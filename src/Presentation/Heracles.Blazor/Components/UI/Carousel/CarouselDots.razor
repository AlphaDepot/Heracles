@inject CarouselService CarouselService
@implements IDisposable
<div class="@ContainerClass">
	@for (var i = 0; i < ItemsCount; i++)
	{
		var i1 = i;
		<button
			class="@DotClass(i)"
			@onclick="() => ScrollTo(i1)">
		</button>
	}
</div>

@code {
	[Parameter] public int ItemsCount { get; set; }
	[Parameter] public string Class { get; set; } = string.Empty;

	[CascadingParameter(Name = "CarouselId")]
	public string CarouselId { get; set; } = null!;

	private int _current;


	private string ContainerClass =>
		Tw.Merge("absolute bottom-4 left-0 right-0 flex items-center justify-center gap-2 z-20", Class);


	protected override void OnInitialized()
	{
		CarouselService.StateChanged += OnStateChanged;
		_current = CarouselService.GetSelectedIndex(CarouselId);
	}

	private void OnStateChanged(string id)
	{
		if (id != CarouselId)
			return;

		_current = CarouselService.GetSelectedIndex(CarouselId);
		InvokeAsync(StateHasChanged);
	}

	private async Task ScrollTo(int index)
	{
		await CarouselService.ScrollToAsync(CarouselId, index);
	}

	private string DotClass(int index)
	{
		var active = index == _current;
		return active
			? "h-3 w-3 rounded-full border-2 bg-white border-white"
			: "h-3 w-3 rounded-full border-2 border-white/60";
	}

	public void Dispose()
	{
		CarouselService.StateChanged -= OnStateChanged;
	}

}