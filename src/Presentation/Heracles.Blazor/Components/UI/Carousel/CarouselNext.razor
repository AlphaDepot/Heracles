@inject CarouselService CarouselService
@implements IDisposable
<button disabled="@(!_canGoNext)"
        @onclick="Next"
        class="@NextClass">

	<Icon Kind="@Lucide.Outline.ArrowRight" Size="IconSize.Small"/>
	<span class="sr-only">Next slide</span>
</button>

@code {

	[CascadingParameter(Name = "CarouselId")]
	public string CarouselId { get; set; } = null!;

	[Parameter] public bool Inline { get; set; }

	[CascadingParameter(Name = "Orientation")]
	public CarouselOrientation CarouselOrientation { get; set; } = CarouselOrientation.Horizontal;

	[Parameter] public string Class { get; set; } = string.Empty;
	private bool _canGoNext;

	private string NextClass => Inline
		? Tw.Merge("h-8 w-8 rounded-full flex items-center justify-center", Class)
		: Tw.Merge(
			"absolute h-8 w-8 rounded-full",
			CarouselOrientation == CarouselOrientation.Horizontal
				? "absolute -right-12 top-1/2 -translate-y-1/2"
				: "absolute -bottom-12 left-1/2 -translate-x-1/2 rotate-90",
			Class
		);


	protected override void OnInitialized()
	{
		CarouselService.StateChanged += OnStateChanged;
	}

	private void OnStateChanged(string id)
	{
		if (id != CarouselId)
			return;

		_canGoNext = CarouselService.CanGoNext(CarouselId);
		InvokeAsync(StateHasChanged);
	}

	private async Task Next()
	{
		await CarouselService.GoNextAsync(CarouselId);
	}

	public void Dispose()
	{
		CarouselService.StateChanged -= OnStateChanged;
	}

}