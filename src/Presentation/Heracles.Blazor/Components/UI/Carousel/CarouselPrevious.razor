@inject CarouselService CarouselService
@implements IDisposable
<button Disabled="@(!_canGoPrev)"
        @onclick="Prev"
        class="@PrevClass">
	<Icon Kind="@Lucide.Outline.ArrowLeft" Size="Size.Small"/>
	<span class="sr-only">Previous slide</span>
</button>

@code {

	[CascadingParameter(Name = "CarouselId")]
	public string CarouselId { get; set; } = null!;

	[CascadingParameter(Name = "Orientation")]
	public Orientation Orientation { get; set; } = Orientation.Horizontal;

	[Parameter] public string Class { get; set; } = string.Empty;
	[Parameter] public bool Inline { get; set; }


	private bool _canGoPrev;


	private string PrevClass => Inline
		? Tw.Merge("h-8 w-8 rounded-full flex items-center justify-center", Class)
		: Tw.Merge(
			"absolute h-8 w-8 rounded-full",
			Orientation == Orientation.Horizontal
				? "absolute -left-12 top-1/2 -translate-y-1/2"
				: "absolute -top-12 left-1/2 -translate-x-1/2 rotate-90",
			Class
		);

	protected override void OnInitialized()
	{
		CarouselService.StateChanged += OnStateChanged;
	}

	private void OnStateChanged(string id)
	{
		if (id != CarouselId)
			return;

		_canGoPrev = CarouselService.CanGoPrev(CarouselId);
		InvokeAsync(StateHasChanged);
	}

	private async Task Prev()
	{
		await CarouselService.GoPrevAsync(CarouselId);
	}

	public void Dispose()
	{
		CarouselService.StateChanged -= OnStateChanged;
	}

}