@namespace Heracles.Blazor.Components.UI.Inputs
@implements IAsyncDisposable

<input
    @ref="inputRef"
    id="@EffectiveId"
    name="@EffectiveName"
    type="@HtmlType"
    class="@CssClass"
    value="@(Type == InputType.File ? null : Value)"
    placeholder="@Placeholder"
    disabled="@Disabled"
    required="@Required"
    aria-label="@AriaLabel"
    aria-describedby="@AriaDescribedBy"
    aria-invalid="@EffectiveAriaInvalid"
    @attributes="AdditionalAttributes" />
