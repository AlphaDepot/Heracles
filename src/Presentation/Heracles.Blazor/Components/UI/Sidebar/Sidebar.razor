@namespace Heracles.Blazor.Components.UI.Sidebar


<aside class="@ComputedClass" style="@SidebarStyle" @attributes="AdditionalAttributes">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</aside>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Collapsible { get; set; }
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }
    [Parameter] public string ExpandedWidth { get; set; } = "16rem";
    [Parameter] public string CollapsedWidth { get; set; } = "3.5rem";
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Tw.Merge(
        "flex h-full shrink-0 flex-col border-r border-sidebar-border bg-sidebar text-sidebar-foreground " +
        "transition-[width] duration-300",
        Collapsed ? "w-[var(--sidebar-width-collapsed)]" : "w-[var(--sidebar-width)]",
        Class);

    private string SidebarStyle => $"--sidebar-width:{ExpandedWidth};--sidebar-width-collapsed:{CollapsedWidth};";

    internal async Task ToggleCollapsed()
    {
        if (Collapsible)
        {
            Collapsed = !Collapsed;
            await CollapsedChanged.InvokeAsync(Collapsed);
        }
    }
}
