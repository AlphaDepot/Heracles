<div
	role="tab"
	class="@TriggerClass"
	data-state="@(Parent.CurrentValue == Value ? "active" : "inactive")"
	@onclick="() => Parent.SetValueAsync(Value)">
	@ChildContent
</div>

@code {
	[CascadingParameter] public Tabs Parent { get; set; } = null!;
	[Parameter] public string Value { get; set; } = null!;
	[Parameter] public RenderFragment? ChildContent { get; set; }
	[Parameter] public string Class { get; set; } = null!;

	private string TriggerClass => Tw.Merge(
		"cursor-pointer inline-flex items-center justify-center whitespace-nowrap rounded-sm px-3 py-1.5 text-sm font-medium",
		"ring-offset-background! transition-all",
		"focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
		"disabled:pointer-events-none disabled:opacity-50",
		Parent.CurrentValue == Value ? "bg-background! text-foreground! shadow-sm" : "",
		Class
	);

}