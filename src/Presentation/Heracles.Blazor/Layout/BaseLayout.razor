@using Heracles.Blazor.Components.UI.Sidebar
@using Heracles.Blazor.Components.UI.Toast
@using Heracles.Blazor.Theme
@inherits LayoutComponentBase
@inject IThemeManager ThemeManager

<div class="page flex">
	<Sidebar Collapsible="true" @bind-Collapsed="sidebarCollapsed" Class="min-h-screen">
		<SidebarHeader>
			@if (sidebarCollapsed)
			{
				<SidebarTrigger />
			}
			else
			{
				<div class="flex items-center gap-2">
					<div class="flex h-8 w-8 items-center justify-center rounded-md bg-primary text-primary-foreground text-sm font-semibold">A</div>
					<span class="font-semibold">Acme</span>
				</div>
				<SidebarTrigger />
			}
		</SidebarHeader>
		<SidebarContent>
			<SidebarMenu>
				<SidebarMenuItem Href="/" Active="true" Title="Dashboard">
					<Icon>🏠</Icon>
					<ChildContent>Dashboard</ChildContent>
				</SidebarMenuItem>
				
				
				<SidebarGroupLabel>Admin</SidebarGroupLabel>
				<SidebarGroupContent>
					<SidebarMenuItem Href="/admin/ui-showcase" Badge="3" Title="Notifications">
						<Icon>🧩</Icon>
						<ChildContent>Notifications</ChildContent>
					</SidebarMenuItem>
					<SidebarMenuItem Href="/notfound-6000" Badge="3" Title="Notifications">
						<Icon>🕳️</Icon>
						<ChildContent>Test NotFound</ChildContent>
					</SidebarMenuItem>
				</SidebarGroupContent>
			</SidebarMenu>
		</SidebarContent>
	</Sidebar>
	
	<main class="p-4 grow">
		<div class="top-row px-4">
			<a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
		</div>

		<article class="content px-4 w-full">
			@Body
		</article>
	</main>
</div>

<ToastProvider Position="ToastPosition.BottomRight" ShowCountdown="true" />

@code {
	private bool sidebarCollapsed;
	
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			ThemeManager.OnChange += () => InvokeAsync(StateHasChanged);
			await ThemeManager.InitializeAsync();
		}
	}
}
