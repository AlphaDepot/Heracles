@page "/"
@using Heracles.Blazor.Components.UI.Toast
@inject ToastService ToastService
<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.
<div class="mt-4 flex flex-col gap-2">
	<ThemeToggler />
	
	<div>
		<Button @onclick="NormalToast" Variant="Variant.Outlined">Normal Toast</Button>
		<Button @onclick="ErrorToast" Variant="Variant.Destructive">Error Toast</Button>
	</div>
</div>

@code {

	private void NormalToast()
	{
		ToastService.Show("Friday, February 10, 2023 at 5:57 PM", "Scheduled: Catch up");
	}
	
	private void ErrorToast()
	{
		ToastService.Error("There was a problem with your request.", "Uh oh! Something went wrong.");
	}

}


